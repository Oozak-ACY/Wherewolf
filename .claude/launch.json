{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "server",
      "runtimeExecutable": "cargo",
      "runtimeArgs": ["run", "-p", "wherewolf-server"],
      "port": 3000
    },
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "client", "run", "dev", "--", "--port", "5173"],
      "port": 5173
    },
    {
      "name": "proto-narrator-voice",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "prototype/narrator-voice", "run", "proto", "--", "--port", "5180"],
      "port": 5180
    }
  ]
}
