# Copy to .env (git-ignored) and fill in from your LiveKit Cloud project → Settings → Keys.
# Only the game server reads these. Never commit the real values.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# From ElevenLabs → Developers → API keys: voices the Narrator's live lines
# (the ones with names). Without it, they use the browser's voice.
ELEVENLABS_API_KEY=
# Optional: another voice than the Narrator's ("Narrateur sombre").
# ELEVENLABS_VOICE_ID=
